# ========== 应用 ==========
APP_NAME=华普智选
APP_ENV=development
DEBUG=true

# ========== 数据库（动态切换）==========
# sqlite（开发）| postgresql（生产）
DB_TYPE=sqlite
# 若填写 DATABASE_URL 则优先使用；否则按 DB_TYPE 自动拼接
# sqlite 示例：sqlite:///./data/smart_selection.db
# postgresql 示例：postgresql+psycopg://user:pass@localhost:5432/smart_selection
DATABASE_URL=

# PostgreSQL 分项配置（DB_TYPE=postgresql 且未提供 DATABASE_URL 时必填）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=smart_selection

# ========== JWT / 安全（必填）==========
SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ========== 登录防爆破 ==========
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30

# ========== Redis（登录认证缓存）==========
# 优先 REDIS_URL；否则用 HOST/PORT/DB/PASSWORD
REDIS_URL=
REDIS_HOST=192.168.200.180
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=smart-selection

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ========== 数据源接入层 ==========
# mock（默认，离线）| fakestore（公开演示 API）| amazon | shopee
# amazon / shopee 缺凭据时回落 mock
DATA_SOURCE=mock

# Amazon SP-API（LWA OAuth）
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# ========== LLM（可选，OpenAI 兼容接口）==========
# mock（默认）| openai（真实调用）
LLM_MODE=mock
# 阿里云百炼千问推荐配置；未配置任何 Key 时自动回落 mock
DASHSCOPE_API_KEY=
# 留空时按 Key 自动选择：千问 qwen-plus / DeepSeek deepseek-chat / OpenAI gpt-4o-mini
LLM_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 可选；千问默认 https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
