# ========== 应用 ==========
APP_NAME=华普智选
# development | production
APP_ENV=production
DEBUG=false

# ========== 数据库（动态切换）==========
# sqlite（本地开发）| postgresql（Docker / 生产）
DB_TYPE=postgresql
# 若填写 DATABASE_URL 则优先使用；否则按 DB_TYPE / POSTGRES_* 自动拼接
DATABASE_URL=

# PostgreSQL（docker compose 中 POSTGRES_HOST 会被覆盖为 db）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hpzx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=smart_selection
# 宿主机映射端口（可选）
POSTGRES_PUBLISH_PORT=5432

# ========== JWT / 安全（必填）==========
# 生产环境请换成足够长的随机串；禁止使用下方占位值
SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ========== 登录防爆破 ==========
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30

# ========== Redis（登录认证 / ARQ）==========
# docker compose 中 REDIS_HOST 会被覆盖为 redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=smart-selection
REDIS_PUBLISH_PORT=6379
ARQ_QUEUE_NAME=smart-selection:arq
ARQ_TIMEZONE=Asia/Shanghai

# ========== 选品扫描 Webhook（预留，可选）==========
SELECTION_WEBHOOK_URL=
SELECTION_WEBHOOK_TIMEOUT_SECONDS=5
SELECTION_RESCORE_THRESHOLD=0.20

# ========== CORS ==========
# Docker 前端经 80 端口访问时需包含 localhost
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173

# ========== 对外发布端口（compose）==========
API_PUBLISH_PORT=8000
FRONTEND_PUBLISH_PORT=80
BOOTSTRAP_WAIT_SECONDS=90

# ========== 前端构建 ==========
# 浏览器同源调用，nginx 将 /api 反代到 api:8000
VITE_API_BASE_URL=/api/v1

# ========== 数据源接入层 ==========
# mock（默认）| dummyjson（推荐免费联调）| fakestore（兼容，已映射到 DummyJSON）| amazon | shopee
DATA_SOURCE=dummyjson
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# ========== LLM（可选）==========
LLM_MODE=mock
DASHSCOPE_API_KEY=
LLM_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
